# Local: sqlite. Production on Vercel: postgres. Never expose secrets with NEXT_PUBLIC_.
STORAGE_DRIVER=sqlite
SQLITE_PATH=.data/pilot.sqlite
# Generate independent random secrets, >=32 characters. Required before any non-local deployment.
# Local operation creates persistent local-only secrets in ignored .data/local-secrets.json if omitted.
SESSION_SECRET=
RATE_LIMIT_SECRET=
AI_MODE=mock
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-4.1-mini
QUOTA_SESSION_HOUR=5
QUOTA_IP_HOUR=10
QUOTA_GLOBAL_DAY=100
# Optional Supabase API credentials; the backend uses INTEGRATION_DATABASE_URL.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
COMPANY_LABEL=Seu software de gestão
ERP_CTA_URL=
PRIVACY_CONTACT_EMAIL=

# Firebase Authentication (Google): public web config is passed to the login page.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
# Server only: one-line service account JSON, or use Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Postgres privado compartilhado por contas, leads, API e worker em produção.
# Use bancos separados por ambiente; configure TLS verificado em conexões remotas.
INTEGRATION_DATABASE_URL=
INTEGRATION_ENVIRONMENT=sandbox
INTEGRATION_API_BASE_URL=http://127.0.0.1:3000/api/v1
# Somente testes, apontando para banco descartável migrado.
INTEGRATION_TEST_DATABASE_URL=

# Vercel Cron authentication, independent random secret >=32 characters.
CRON_SECRET=

# Trusted Supabase root CA in PEM format for verified TLS connections.
INTEGRATION_DATABASE_CA=
